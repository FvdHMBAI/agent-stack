#!/usr/bin/env bash
set -euo pipefail

# AgentStack CLI — unified interface for all components
VERSION="1.0.0"
INSTALL_DIR="${AGENT_STACK_DIR:-$HOME/.agent-stack}"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

usage() {
  echo -e "${BOLD}AgentStack${NC} v${VERSION} — The Open-Source AI Agent Operating System"
  echo ""
  echo -e "${BOLD}USAGE${NC}"
  echo "    agent-stack <command> [args...]"
  echo ""
  echo -e "${BOLD}COMMANDS${NC}"
  echo -e "    ${CYAN}guard${NC}    [args]    Run GuardRail (pre-execution security for AI agents)"
  echo -e "    ${CYAN}route${NC}    [args]    Run Model Router (cost-optimized LLM routing)"
  echo -e "    ${CYAN}night${NC}    [args]    Run Night Shift (autonomous maintenance)"
  echo -e "    ${CYAN}graph${NC}    [args]    Run Graphify (codebase knowledge graphs)"
  echo -e "    ${CYAN}auto${NC}     [args]    Run Autonomie OS (self-improving agent framework)"
  echo ""
  echo -e "${BOLD}META${NC}"
  echo -e "    ${CYAN}status${NC}            Show status of all components"
  echo -e "    ${CYAN}doctor${NC}            Health check — verify installation and dependencies"
  echo -e "    ${CYAN}version${NC}           Show version of all components"
  echo -e "    ${CYAN}update${NC}            Pull latest version of all components"
  echo -e "    ${CYAN}help${NC}              Show this help message"
  echo ""
  echo -e "${BOLD}EXAMPLES${NC}"
  echo "    agent-stack guard init                  # Set up guardrails for current project"
  echo "    agent-stack route standard              # Get model config for standard tasks"
  echo "    agent-stack graph build                 # Build knowledge graph for current repo"
  echo "    agent-stack night scan                  # Scan repos for maintenance tasks"
  echo "    agent-stack doctor                      # Verify everything works"
  echo ""
}

component_path() {
  local name="$1"
  echo "$INSTALL_DIR/$name"
}

check_component() {
  local name="$1"
  local path
  path=$(component_path "$name")
  [[ -d "$path" ]]
}

get_component_version() {
  local name="$1"
  local path
  path=$(component_path "$name")
  if [[ -d "$path/.git" ]]; then
    git -C "$path" describe --tags --always 2>/dev/null || git -C "$path" rev-parse --short HEAD 2>/dev/null || echo "unknown"
  else
    echo "not installed"
  fi
}

cmd_guard() {
  local path
  path=$(component_path "guardrail")
  if [[ ! -d "$path" ]]; then
    echo -e "${RED}GuardRail not installed.${NC} Run: agent-stack doctor"
    exit 1
  fi

  local subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$subcmd" in
    init)
      if [[ -f "$path/install.sh" ]]; then
        bash "$path/install.sh" "$@"
      else
        echo -e "${RED}No installer found in $path${NC}"
        exit 1
      fi
      ;;
    check|run)
      local guards_dir="$path/guards"
      if [[ -d "$guards_dir" ]]; then
        echo -e "${BLUE}Running guards from $guards_dir${NC}"
        for guard in "$guards_dir"/*.sh; do
          [[ -f "$guard" ]] || continue
          echo -e "  ${DIM}$(basename "$guard")${NC}"
          bash "$guard" "$@" || echo -e "  ${YELLOW}Warning from $(basename "$guard")${NC}"
        done
      fi
      ;;
    list)
      local guards_dir="$path/guards"
      if [[ -d "$guards_dir" ]]; then
        echo -e "${BOLD}Available guards:${NC}"
        for guard in "$guards_dir"/*.sh; do
          [[ -f "$guard" ]] || continue
          echo "  $(basename "$guard" .sh)"
        done
      fi
      ;;
    *)
      echo -e "${BOLD}GuardRail${NC} — Pre-execution security for AI agents"
      echo ""
      echo "Usage: agent-stack guard <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "    init     Set up guardrails for current project"
      echo "    check    Run all guards against pending command"
      echo "    list     List available guards"
      ;;
  esac
}

cmd_route() {
  local path
  path=$(component_path "model-router")
  if [[ ! -d "$path" ]]; then
    echo -e "${RED}Model Router not installed.${NC} Run: agent-stack doctor"
    exit 1
  fi

  local tier="${1:-help}"

  if [[ "$tier" == "help" ]]; then
    echo -e "${BOLD}Model Router${NC} — Cost-optimized LLM routing"
    echo ""
    echo "Usage: agent-stack route <tier>"
    echo ""
    echo "Tiers: trivial, standard, complex, critical, embedding, vision"
    echo ""
    echo 'Example: eval "$(agent-stack route standard)"'
    return
  fi

  if [[ -f "$path/model-router.sh" ]]; then
    bash "$path/model-router.sh" "$tier"
  elif [[ -f "$path/router.sh" ]]; then
    bash "$path/router.sh" "$tier"
  else
    echo -e "${RED}Router script not found in $path${NC}"
    exit 1
  fi
}

cmd_night() {
  local path
  path=$(component_path "nightshift")
  if [[ ! -d "$path" ]]; then
    echo -e "${RED}Night Shift not installed.${NC} Run: agent-stack doctor"
    exit 1
  fi

  local subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$subcmd" in
    run|start)
      bash "$path/coordinator.sh" "$@"
      ;;
    scan)
      echo -e "${BLUE}Scanning repos...${NC}"
      bash "$path/coordinator.sh" --scan-only "$@" 2>/dev/null || bash "$path/coordinator.sh" "$@"
      ;;
    status)
      if [[ -f "$path/summary.sh" ]]; then
        bash "$path/summary.sh" "$@"
      else
        echo "No summary available"
      fi
      ;;
    *)
      echo -e "${BOLD}Night Shift${NC} — Autonomous overnight maintenance"
      echo ""
      echo "Usage: agent-stack night <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "    run      Start a maintenance run"
      echo "    scan     Scan repos without executing fixes"
      echo "    status   Show last run summary"
      ;;
  esac
}

cmd_graph() {
  local path
  path=$(component_path "graphify-toolkit")
  if [[ ! -d "$path" ]]; then
    echo -e "${RED}Graphify not installed.${NC} Run: agent-stack doctor"
    exit 1
  fi

  local subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$subcmd" in
    build)
      if [[ -f "$path/graphify-core.sh" ]]; then
        bash "$path/graphify-core.sh" build "$@"
      elif [[ -f "$path/build.sh" ]]; then
        bash "$path/build.sh" "$@"
      fi
      ;;
    query)
      if [[ -f "$path/graphify-core.sh" ]]; then
        bash "$path/graphify-core.sh" query "$@"
      fi
      ;;
    path)
      if [[ -f "$path/graphify-core.sh" ]]; then
        bash "$path/graphify-core.sh" path "$@"
      fi
      ;;
    stats)
      if [[ -f "$path/graphify-core.sh" ]]; then
        bash "$path/graphify-core.sh" stats "$@"
      fi
      ;;
    *)
      echo -e "${BOLD}Graphify${NC} — Codebase knowledge graphs"
      echo ""
      echo "Usage: agent-stack graph <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "    build    Build knowledge graph for current repo"
      echo "    query    Query the knowledge graph"
      echo "    path     Find shortest path between concepts"
      echo "    stats    Show graph statistics"
      ;;
  esac
}

cmd_auto() {
  local path
  path=$(component_path "autonomie-os")
  if [[ ! -d "$path" ]]; then
    echo -e "${RED}Autonomie OS not installed.${NC} Run: agent-stack doctor"
    exit 1
  fi

  local subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$subcmd" in
    run|start)
      if [[ -f "$path/autonomie.sh" ]]; then
        bash "$path/autonomie.sh" "$@"
      fi
      ;;
    learn)
      if [[ -f "$path/learning-engine.py" ]]; then
        python3 "$path/learning-engine.py" "$@"
      fi
      ;;
    *)
      echo -e "${BOLD}Autonomie OS${NC} — Self-improving agent framework"
      echo ""
      echo "Usage: agent-stack auto <subcommand>"
      echo ""
      echo "Subcommands:"
      echo "    run      Start the autonomy loop"
      echo "    learn    Run the learning engine"
      ;;
  esac
}

cmd_status() {
  echo -e "${BOLD}AgentStack Status${NC}"
  echo ""

  local components=("guardrail" "model-router" "nightshift" "graphify-toolkit" "autonomie-os")
  local labels=("GuardRail" "Model Router" "Night Shift" "Graphify" "Autonomie OS")
  local descriptions=("Pre-execution security" "Cost-optimized LLM routing" "Autonomous maintenance" "Knowledge graphs" "Self-improving framework")

  for i in "${!components[@]}"; do
    local name="${components[$i]}"
    local label="${labels[$i]}"
    local desc="${descriptions[$i]}"
    local path
    path=$(component_path "$name")

    if [[ -d "$path" ]]; then
      local ver
      ver=$(get_component_version "$name")
      echo -e "  ${GREEN}●${NC} ${BOLD}${label}${NC} ${DIM}(${ver})${NC}"
      echo -e "    ${desc}"
    else
      echo -e "  ${RED}○${NC} ${BOLD}${label}${NC} ${DIM}(not installed)${NC}"
      echo -e "    ${desc}"
    fi
  done
  echo ""
}

cmd_doctor() {
  echo -e "${BOLD}AgentStack Doctor${NC}"
  echo ""
  local issues=0

  echo -e "${BOLD}Prerequisites:${NC}"
  for cmd in bash git curl jq; do
    if command -v "$cmd" &>/dev/null; then
      local ver
      ver=$("$cmd" --version 2>&1 | head -1 | grep -oP '[\d]+\.[\d]+' | head -1 || echo "ok")
      echo -e "  ${GREEN}●${NC} $cmd ${DIM}($ver)${NC}"
    else
      echo -e "  ${RED}●${NC} $cmd ${DIM}(missing)${NC}"
      issues=$((issues + 1))
    fi
  done

  local bash_major="${BASH_VERSINFO[0]}"
  if [[ "$bash_major" -lt 4 ]]; then
    echo -e "  ${RED}●${NC} Bash 4+ required ${DIM}(found $BASH_VERSION)${NC}"
    issues=$((issues + 1))
  fi

  echo ""
  echo -e "${BOLD}Optional:${NC}"
  for cmd in shellcheck python3 psql docker; do
    if command -v "$cmd" &>/dev/null; then
      echo -e "  ${GREEN}●${NC} $cmd"
    else
      echo -e "  ${YELLOW}○${NC} $cmd ${DIM}(optional)${NC}"
    fi
  done

  if command -v ollama &>/dev/null; then
    if curl -s -o /dev/null -w '%{http_code}' http://localhost:11434/api/tags 2>/dev/null | grep -q "200"; then
      echo -e "  ${GREEN}●${NC} Ollama ${DIM}(running)${NC}"
    else
      echo -e "  ${YELLOW}○${NC} Ollama ${DIM}(installed but not running)${NC}"
    fi
  else
    echo -e "  ${YELLOW}○${NC} Ollama ${DIM}(not installed)${NC}"
  fi

  echo ""
  echo -e "${BOLD}Components:${NC}"
  local components=("guardrail" "model-router" "nightshift" "graphify-toolkit" "autonomie-os")
  for name in "${components[@]}"; do
    local path
    path=$(component_path "$name")
    if [[ -d "$path" ]]; then
      echo -e "  ${GREEN}●${NC} $name"
    else
      echo -e "  ${RED}●${NC} $name ${DIM}(not installed)${NC}"
      issues=$((issues + 1))
    fi
  done

  echo ""
  echo -e "${BOLD}Install directory:${NC} $INSTALL_DIR"

  echo ""
  if [[ "$issues" -eq 0 ]]; then
    echo -e "  ${GREEN}${BOLD}All checks passed${NC}"
  else
    echo -e "  ${YELLOW}${BOLD}$issues issue(s) found${NC}"
    echo -e "  Run ${CYAN}agent-stack update${NC} to install missing components"
  fi
}

cmd_version() {
  echo -e "${BOLD}AgentStack${NC} v${VERSION}"
  echo ""
  local components=("guardrail" "model-router" "nightshift" "graphify-toolkit" "autonomie-os")
  for name in "${components[@]}"; do
    local ver
    ver=$(get_component_version "$name")
    printf "  %-20s %s\n" "$name" "$ver"
  done
}

cmd_update() {
  echo -e "${BOLD}Updating AgentStack components...${NC}"
  echo ""
  local components=("guardrail" "model-router" "nightshift" "graphify-toolkit" "autonomie-os")

  for name in "${components[@]}"; do
    local path
    path=$(component_path "$name")
    if [[ -d "$path/.git" ]]; then
      echo -n "  Updating $name... "
      if git -C "$path" pull --quiet 2>/dev/null; then
        echo -e "${GREEN}done${NC}"
      else
        echo -e "${YELLOW}failed${NC}"
      fi
    else
      echo -e "  ${DIM}$name not installed, skipping${NC}"
    fi
  done
  echo ""
  echo -e "${GREEN}Update complete.${NC}"
}

case "${1:-help}" in
  guard)  shift; cmd_guard "$@" ;;
  route)  shift; cmd_route "$@" ;;
  night)  shift; cmd_night "$@" ;;
  graph)  shift; cmd_graph "$@" ;;
  auto)   shift; cmd_auto "$@" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  version|-v|--version) cmd_version ;;
  update) cmd_update ;;
  help|-h|--help) usage ;;
  *)
    echo -e "${RED}Unknown command: $1${NC}"
    echo ""
    usage
    exit 1
    ;;
esac
